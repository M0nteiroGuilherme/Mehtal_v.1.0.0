        log_frame.pack(fill=BOTH, expand=True, padx=15, pady=(0,15))

        self.log_text = scrolledtext.ScrolledText(log_frame, font=("Consolas", 9), bg="#1e1e1e", fg="#d4d4d4", 
                                                   insertbackground="white", relief=FLAT, padx=10, pady=10)
        self.log_text.pack(fill=BOTH, expand=True)
        self.log_text.insert(END, "Bem-vindo ao Gerador APQP!\n")
        self.log_text.insert(END, f"Pasta do app: {APP_DIR}\n")
        
        # Carregar salvo
        apqp_salva = ler_apqp_json()
        if apqp_salva:
            self.entry_apqp.insert(0, apqp_salva)
            self.log(f"APQP carregada do conf.json: {apqp_salva}")

    def log(self, msg):
        def _log():
            self.log_text.insert(END, msg + "\n")
            self.log_text.see(END)
            self.root.update_idletasks()
        # thread safe
        if threading.current_thread() is threading.main_thread():
            _log()
        else:
            self.root.after(0, _log)

    def procurar_arquivo(self):
        arquivo = filedialog.askopenfilename(
            title="Selecione a APQP",
            filetypes=[("Excel", "*.xlsx *.xlsm"), ("Todos", "*.*")]
        )
        if arquivo:
            nome = Path(arquivo).stem
            self.entry_apqp.delete(0, END)
            self.entry_apqp.insert(0, nome)
            self.log(f"Arquivo selecionado: {arquivo}")
            self.log(f"Nome extraído: {nome} (será salvo só o nome)")

    def salvar_apqp(self):
        nome = self.entry_apqp.get().strip()
        if not nome:
            messagebox.showwarning("Aviso", "Digite o nome da APQP")
            return
        try:
            salvo = salvar_apqp_json(nome)
            self.log(f"💾 Salvo em {CONF_PATH}: {salvo}")
            messagebox.showinfo("Salvo", f"APQP '{salvo}' salva com sucesso!\nO sistema vai procurar '{salvo}.xlsx' no seu PC quando você clicar em Criar.")
        except Exception as e:
            messagebox.showerror("Erro", str(e))

    def executar(self, tipo):
        nome = self.entry_apqp.get().strip() or ler_apqp_json()
        if not nome:
            messagebox.showwarning("Aviso", "Configure a APQP primeiro na etapa 1")
            return
        inicio = self.entry_inicio.get().strip()
        fim = self.entry_fim.get().strip()
        if not inicio or not fim:
            messagebox.showwarning("Aviso", "Preencha linha inicial e final")
            return
        try:
            int(inicio)
            int(fim)
        except:
            messagebox.showwarning("Aviso", "Linhas devem ser números")
            return

        # desativa botões
        self.btn_acc.config(state=DISABLED, text="⏳ Processando...")
        self.btn_fiin.config(state=DISABLED, text="⏳ Processando...")

        def tarefa():
            try:
                self.log(f"\n{'='*50}")
                self.log(f"Iniciando {tipo} - Linhas {inicio} até {fim} - APQP: {nome}")
                dados = PegandoDados_APQP(nome, inicio, fim, log_func=self.log)
                if tipo == "ACC":
                    qtd = CriandoPastas(*dados, log_func=self.log)
                    self.log(f"\n🎉 Finalizado! {qtd} pastas criadas.")
                    self.root.after(0, lambda: messagebox.showinfo("Concluído", f"{qtd} pastas ACC + Custo criadas com sucesso!"))
                else:
                    PN_MethalLsit, PNsList, REVList, RFQList, ClientePlantaList, VolumeAnualList, DataEntradaList, DataRespostaList, tipoList, descricaoLista, ListaFormanta_CompradorACC, compradorList, ClienteList, PesoList, Declinar = dados
                    qtd = CriandoFIIN(PN_MethalLsit, PNsList, REVList, RFQList, ClientePlantaList, VolumeAnualList, tipoList, descricaoLista, ClienteList, compradorList, Declinar, log_func=self.log)
                    self.log(f"\n🎉 Finalizado! {qtd} FIINs criadas.")
                    self.root.after(0, lambda: messagebox.showinfo("Concluído", f"{qtd} FIINs criadas com sucesso!"))
            except FileNotFoundError as e:
                self.log(f"❌ {e}")
                self.root.after(0, lambda: messagebox.showerror("Arquivo não encontrado", str(e)))
            except Exception as e:
                import traceback
                err = traceback.format_exc()
                self.log(f"❌ Erro: {e}\n{err}")
                self.root.after(0, lambda: messagebox.showerror("Erro", f"{e}\n\nVeja o log para detalhes"))
            finally:
                self.root.after(0, lambda: self.btn_acc.config(state=NORMAL, text="📁  CRIAR ACC + CUSTO"))
                self.root.after(0, lambda: self.btn_fiin.config(state=NORMAL, text="📄  CRIAR FIIN"))

        threading.Thread(target=tarefa, daemon=True).start()


if __name__ == "__main__":
    root = Tk()
    app = App(root)
    root.mainloop()
